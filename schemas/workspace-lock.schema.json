{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://default2368.github.io/nexus-lab/schemas/workspace-lock.schema.json",
  "title": "Nexus Lab resolved workspace lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "programWorkspaceRoot", "controlPlaneRoot", "runWorkspacesRoot", "allowedPlanIds", "projects", "digests", "metadata"],
  "properties": {
    "schemaVersion": { "const": "nexus-lab/workspace-lock/v1" },
    "workspaceId": { "type": "string" },
    "programWorkspaceRoot": { "type": "string", "minLength": 1 },
    "controlPlaneRoot": { "type": "string", "minLength": 1 },
    "runWorkspacesRoot": { "type": "string", "minLength": 1 },
    "allowedPlanIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "path", "resolvedPath", "type", "runtime", "role", "git", "gitSnapshot"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "resolvedPath": { "type": "string" },
          "type": { "type": "string" },
          "runtime": { "type": "string" },
          "role": { "type": "string" },
          "git": {
            "anyOf": [
              { "type": "null" },
              { "type": "object", "additionalProperties": false, "required": ["remote"], "properties": { "remote": { "type": ["string", "null"] } } }
            ]
          },
          "gitSnapshot": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["root", "head", "remote"],
                "properties": {
                  "root": { "type": "string" },
                  "head": { "type": ["string", "null"] },
                  "remote": { "type": ["string", "null"] }
                }
              }
            ]
          }
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specDigest", "bindingDigest", "resolutionDigest"],
      "properties": {
        "specDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bindingDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "resolutionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt"],
      "properties": { "generatedAt": { "type": "string", "format": "date-time" } }
    }
  }
}
